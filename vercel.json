{ 
    "version": 2, 
    "builds": [
        { 
        "src": "api/*.js", 
        "use": "@vercel/node" 
        }
    ],
    "routes": [
        {
          "src": "/api",
          "dest": "/api/index.js"
        },
        {
          "src": "/api/user",
          "dest": "/api/user.js"
        }
      ]
}